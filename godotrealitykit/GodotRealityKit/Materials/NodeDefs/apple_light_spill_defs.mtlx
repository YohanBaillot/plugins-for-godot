<?xml version="1.0"?>

<materialx version="1.38">
    <nodedef name="ND_realitykit_light_spill_diffuse_for_pfrm_content" node="realitykit_light_spill_diffuse_for_pfrm_content" target="realitykit_surface_shader" nodegroup="realitykit">
        <input name="emitterUV" type="vector2" defaultgeomprop="UV0"/>
