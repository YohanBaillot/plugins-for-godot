<?xml version="1.0" encoding="UTF-8" ?>
<class name="RealityHoverEffect3D" inherits="Node3D" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Add a RealityHoverEffect3D as a child of a Node3D to give it a
		hover effect on visionOS.
	</brief_description>
	<description>
		This wraps RealityKit's [url=https://developer.apple.com/documentation/RealityKit/HoverEffectComponent]HoverEffectComponent[/url].
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="color" type="Color" setter="set_color" getter="get_color" default="Color(0, 0, 0, 1)">
			Color of the hover effect, when looked at.
		</member>
		<member name="color_enabled" type="bool" setter="set_color_enabled" getter="get_color_enabled" default="false">
			Whether to use a custom color, or use the default white effect.
		</member>
		<member name="strength" type="float" setter="set_strength" getter="get_strength" default="1.0">
			Strength of the hover effect.
		</member>
		<member name="style" type="int" setter="set_style" getter="get_style" enum="RealityHoverEffect3D.Style" default="0">
			Style of the hover effect (highlight or spotlight).
		</member>
	</members>
</class>
