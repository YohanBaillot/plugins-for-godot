// Build settings for the GodotRealityKitTests xctest bundle target.
// Project-level settings come from Config.xcconfig (applied automatically).

CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

HEADER_SEARCH_PATHS = $(SRCROOT)/../deps/godot $(SRCROOT)/../deps $(SRCROOT)/../deps/godot-cpp/include $(SRCROOT)/../deps/godot-cpp/gen/include $(SRCROOT)/../deps/godot-cpp/gdextension $(PROJECT_DIR) $(SRCROOT)/../deps/godot/platform/macos $(BUILT_PRODUCTS_DIR)/GodotRealityKit.framework/Headers

PRODUCT_BUNDLE_IDENTIFIER = com.example.GodotRealityKitTests
PRODUCT_NAME = $(TARGET_NAME)
STRING_CATALOG_GENERATE_SYMBOLS = NO
SWIFT_EMIT_LOC_STRINGS = NO
SWIFT_OBJC_BRIDGING_HEADER = Tests/Common/GodotRealityKitTests-Bridging-Header.h
SWIFT_INSTALL_OBJC_HEADER = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_VERSION = 5.0

ONLY_ACTIVE_ARCH[config=Debug] = YES
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG $(inherited)
